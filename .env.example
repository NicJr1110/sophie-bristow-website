# Copy to .env (for `astro dev`) and .dev.vars (for `wrangler pages dev`).
# In production, set all of these in Cloudflare Pages > Settings > Variables and Secrets.

# Public (safe to expose) – leave the project ID blank to run with placeholder content
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
SITE_URL=http://localhost:8788

# Secrets – server functions only
SANITY_WRITE_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM="Sophie Bristow <hello@your-domain.co.uk>"
CONTACT_TO_EMAIL=sophiebristow95@gmail.co.uk

# Comma-separated ISO country codes Stripe will ship to
SHIP_COUNTRIES=GB
