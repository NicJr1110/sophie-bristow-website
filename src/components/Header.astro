---
import { SITE_NAME, USE_MONOGRAM } from '../lib/config';
import { getNav, getShopTags } from '../lib/content';
import Boil from './Boil.astro';
import ScratchLink from './ScratchLink.astro';

interface Props {
  current: string;
  /** Shown next to the logo on burger-menu screens. */
  title?: string;
}
const { current, title } = Astro.props;
const [NAV, tags] = await Promise.all([getNav(), getShopTags()]);

// Shop categories come straight from the shop tags, so a tag Sophie adds just appears.
// On laptops "Shop" itself links to everything; the burger menu's Shop only opens the list,
// so it gets an "all" link at the end.
const shopLinks = tags.map((t) => ({ label: t.title, href: `/shop/?tag=${t.slug}`, tag: t.slug }));
const mobileShopLinks = [...shopLinks, { label: 'all', href: '/shop/', tag: '' }];
const isCurrent = (href: string) => current.startsWith(href);
---

<header class="site-header">
  <a class="site-name" href="/" aria-label={USE_MONOGRAM ? SITE_NAME : undefined}>
    {USE_MONOGRAM ? <img class="monogram" src="/sb-logo.png" alt="" width="326" height="400" /> : SITE_NAME}
  </a>
  {title && <span class="header-page-title">{title}</span>}

  <!-- Laptops: the menu runs across beside the logo -->
  <nav class="nav-desktop" aria-label="Main">
    <ul>
      {NAV.map((item) =>
        item.href === '/shop/' && shopLinks.length > 0 ? (
          <li class="desktop-shop-item">
            <div class="desktop-shop-heading">
              <ScratchLink href={item.href} label={item.label} current={isCurrent(item.href)} />
              <button
                class="shop-disclosure-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="desktop-shop-submenu"
                aria-label="Show shop categories"
              >
                <span aria-hidden="true"></span>
              </button>
            </div>
            <ul id="desktop-shop-submenu" class="desktop-shop-submenu" hidden>
              {shopLinks.map((link) => (
                <li><ScratchLink {...link} /></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><ScratchLink href={item.href} label={item.label} current={isCurrent(item.href)} /></li>
        ),
      )}
    </ul>
  </nav>

  <!-- Smaller screens: the burger opens a drawer from the right -->
  <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
</header>

<div id="mobile-menu" class="mobile-menu" inert>
  <nav aria-label="Main">
    <ul>
      {NAV.map((item) =>
        item.href === '/shop/' && shopLinks.length > 0 ? (
          <li class="mobile-shop-item">
            <button
              class="shop-disclosure-toggle mobile-shop-label"
              type="button"
              aria-expanded="false"
              aria-controls="mobile-shop-submenu"
            >
              {item.label}
              <span aria-hidden="true"></span>
            </button>
            <ul id="mobile-shop-submenu" class="mobile-shop-submenu" hidden>
              {mobileShopLinks.map((link) => (
                <li><ScratchLink {...link} /></li>
              ))}
            </ul>
          </li>
        ) : (
          <li><ScratchLink href={item.href} label={item.label} current={isCurrent(item.href)} /></li>
        ),
      )}
    </ul>
  </nav>
  <!-- Boils on hover with a mouse; tap to start and stop it on touch screens -->
  <Boil set="flower" play="hover" class="mobile-menu-flower" />
</div>

<script>
  const LINE_COUNT = 17; // public/marks/lines/line-01..17.png
  const LAPTOP = matchMedia('(min-width: 1025px)');

  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');

  /* ---- Shop category lists (laptop dropdown and burger menu) ---- */
  const shopToggles = Array.from(document.querySelectorAll<HTMLButtonElement>('.shop-disclosure-toggle'));
  const setShopOpen = (toggle: HTMLButtonElement, open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    // The burger menu's toggle is labelled by its "Shop" text; the laptop arrow needs a label.
    if (toggle.hasAttribute('aria-label')) {
      toggle.setAttribute('aria-label', open ? 'Hide shop categories' : 'Show shop categories');
    }
    const list = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
    if (list) list.hidden = !open;
  };
  const closeShopLists = () => shopToggles.forEach((t) => setShopOpen(t, false));

  shopToggles.forEach((toggle) =>
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      setShopOpen(toggle, toggle.getAttribute('aria-expanded') !== 'true');
    }),
  );
  // Clicking anywhere else closes the laptop dropdown.
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element && e.target.closest('.desktop-shop-item'))) {
      shopToggles.filter((t) => t.closest('.desktop-shop-item')).forEach((t) => setShopOpen(t, false));
    }
  });

  /* ---- Burger drawer ---- */
  if (btn && menu) {
    let linesLoaded = false;
    const pad = (n: number) => String(n).padStart(2, '0');
    const lineUrl = (n: number) => `/marks/lines/line-${pad(n)}.png`;

    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('is-open', open);
      menu.inert = !open;
      document.documentElement.classList.toggle('menu-open', open);
      if (!open) closeShopLists();
      // Load Sophie's lines the first time the drawer opens, ready for the hover underlines.
      if (open && !linesLoaded) {
        linesLoaded = true;
        for (let i = 1; i <= LINE_COUNT; i++) new Image().src = lineUrl(i);
      }
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    LAPTOP.addEventListener('change', (e) => e.matches && setOpen(false));

    // Each link gets one of Sophie's lines, picked at random, as its underline.
    menu.querySelectorAll<HTMLAnchorElement>('a.scratch').forEach((link) => {
      const draw = () => link.style.setProperty('--line', `url('${lineUrl(1 + Math.floor(Math.random() * LINE_COUNT))}')`);
      link.addEventListener('mouseenter', draw);
      link.addEventListener('focus', draw);
    });

    // Touch screens can't hover, so a tap starts and stops the flower.
    const flower = menu.querySelector<HTMLElement>('.mobile-menu-flower');
    flower?.addEventListener('click', () => {
      if (!matchMedia('(hover: hover)').matches) flower.classList.toggle('is-playing');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (menu.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });
  }

  // Escape closes the laptop dropdown and returns focus to its arrow.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = shopToggles.find((t) => t.closest('.desktop-shop-item') && t.getAttribute('aria-expanded') === 'true');
    if (open) {
      setShopOpen(open, false);
      open.focus();
    }
  });
</script>
