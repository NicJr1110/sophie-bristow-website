---
import { SITE_NAME, USE_MONOGRAM } from '../lib/config';
import { getNav, getShopTags } from '../lib/content';
import ScratchLink from './ScratchLink.astro';

interface Props {
  current: string;
  title?: string;
  subtitle?: string;
}
const { current, title, subtitle } = Astro.props;
const [NAV, SHOP_TAGS] = await Promise.all([getNav(), getShopTags()]);
const artworkTag = SHOP_TAGS.find((tag) => /artwork/i.test(tag.title) || /artwork/i.test(tag.slug));
const giftTag = SHOP_TAGS.find((tag) => /gift/i.test(tag.title) || /gift/i.test(tag.slug));
const shopLinks = [
  { label: 'Artworks', href: `/shop/?tag=${artworkTag?.slug ?? 'artwork'}` },
  { label: 'Gift cards', href: `/shop/?tag=${giftTag?.slug ?? 'gift-cards'}` },
];
const mobileShopLinks = [...shopLinks, { label: 'All', href: '/shop/' }];
const isCurrent = (href: string) => current.startsWith(href);
---

<header class="site-header">
  <a class="site-name" href="/" aria-label={USE_MONOGRAM ? SITE_NAME : undefined}>
    {USE_MONOGRAM ? <img class="monogram" src="/sb-logo.png" alt="" width="326" height="400" /> : SITE_NAME}
  </a>
  {title && <span class="header-page-title">{title}</span>}

  <!-- Large screens: horizontal menu centred under the name -->
  <nav class="nav-desktop" aria-label="Main">
    <ul>
      {NAV.map((item) => item.href === '/shop/' ? (
        <li class="desktop-shop-item">
          <div class="desktop-shop-heading">
            <ScratchLink href={item.href} label={item.label} current={isCurrent(item.href)} />
            <button class="shop-disclosure-toggle desktop-shop-toggle" type="button" aria-expanded="false" aria-controls="desktop-shop-submenu" aria-label="Show shop categories">
              <span aria-hidden="true"></span>
            </button>
          </div>
          <ul id="desktop-shop-submenu" class="desktop-shop-submenu" hidden>
            {shopLinks.map((link) => (
              <li><ScratchLink href={link.href} label={link.label} current={Astro.url.pathname === '/shop/' && Astro.url.searchParams.get('tag') === (link.href.split('tag=')[1] ?? '')} /></li>
            ))}
          </ul>
        </li>
      ) : (
        <li><ScratchLink href={item.href} label={item.label} current={isCurrent(item.href)} /></li>
      ))}
    </ul>
  </nav>

  <!-- Medium/small screens: burger opens a full-screen menu that drops down from the top -->
  <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
    <span></span><span></span><span></span>
  </button>
</header>

<div id="mobile-menu" class="mobile-menu" inert>
  <nav aria-label="Main">
    <ul>
      {NAV.map((item) => item.href === '/shop/' ? (
        <li class="mobile-shop-item">
          <div class="mobile-shop-heading">
            <button class="shop-disclosure-toggle mobile-shop-toggle mobile-shop-label" type="button" aria-expanded="false" aria-controls="mobile-shop-submenu" aria-label="Show shop categories">
              Shop <span aria-hidden="true"></span>
            </button>
          </div>
          <ul id="mobile-shop-submenu" class="mobile-shop-submenu" hidden>
            {mobileShopLinks.map((link) => (
              <li><ScratchLink href={link.href} label={link.label} current={Astro.url.pathname === '/shop/' && Astro.url.searchParams.get('tag') === (link.href.split('tag=')[1] ?? '')} /></li>
            ))}
          </ul>
        </li>
      ) : (
        <li><ScratchLink href={item.href} label={item.href === '/bio/' ? 'About' : item.label} current={isCurrent(item.href)} /></li>
      ))}
    </ul>
  </nav>
  <span class="mobile-menu-flower boil-art" aria-hidden="true">
    {Array.from({ length: 6 }, (_, i) => (
      <img src={`/marks/flowers/flower-${String(i + 1).padStart(2, '0')}.png`} alt="" width="120" height="120" />
    ))}
  </span>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      menu.classList.toggle('is-open', open);
      menu.inert = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };

    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    const shopToggles = document.querySelectorAll<HTMLButtonElement>('.shop-disclosure-toggle');
    shopToggles.forEach((shopToggle) => {
      const submenuId = shopToggle.getAttribute('aria-controls');
      const shopSubmenu = submenuId ? document.getElementById(submenuId) : null;
      if (!shopSubmenu) return;
      shopToggle.addEventListener('click', (event) => {
        event.stopPropagation();
        const expanded = shopToggle.getAttribute('aria-expanded') !== 'true';
        // Keep the desktop and mobile disclosures in sync.
        shopToggles.forEach((otherToggle) => {
          const otherId = otherToggle.getAttribute('aria-controls');
          const otherMenu = otherId ? document.getElementById(otherId) : null;
          otherToggle.setAttribute('aria-expanded', 'false');
          otherToggle.setAttribute('aria-label', 'Show shop categories');
          if (otherMenu) otherMenu.hidden = true;
        });
        shopToggle.setAttribute('aria-expanded', String(expanded));
        shopToggle.setAttribute('aria-label', expanded ? 'Hide shop categories' : 'Show shop categories');
        shopSubmenu.hidden = !expanded;
      });
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('.desktop-shop-item')) {
        const desktopToggle = document.querySelector<HTMLButtonElement>('.desktop-shop-toggle');
        const desktopSubmenu = document.getElementById('desktop-shop-submenu');
        if (desktopToggle) {
          desktopToggle.setAttribute('aria-expanded', 'false');
          desktopToggle.setAttribute('aria-label', 'Show shop categories');
        }
        if (desktopSubmenu) desktopSubmenu.hidden = true;
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });
    // The flower boils on hover with a mouse/trackpad, and toggles on tap on touch screens.
    const menuFlower = menu.querySelector<HTMLElement>('.mobile-menu-flower');
    const canHoverFlower = matchMedia('(hover: hover) and (pointer: fine)');
    if (menuFlower) {
      menuFlower.addEventListener('click', () => {
        if (!canHoverFlower.matches) menuFlower.classList.toggle('is-animating');
      });
    }
    // Reuse Sophie's hand-drawn line artwork for mobile-menu underlines.
    const pad = (n: number) => String(n).padStart(2, '0');
    const pickLine = () => `/marks/lines/line-${pad(1 + Math.floor(Math.random() * 17))}.png`;
    for (let i = 1; i <= 17; i++) new Image().src = `/marks/lines/line-${pad(i)}.png`;
    menu.querySelectorAll<HTMLAnchorElement>('a.scratch').forEach((link) => {
      const draw = () => link.style.setProperty('--line', `url('${pickLine()}')`);
      link.addEventListener('mouseenter', draw);
      link.addEventListener('focus', draw);
    });
    // Close if the screen grows past the burger breakpoint
    matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>
