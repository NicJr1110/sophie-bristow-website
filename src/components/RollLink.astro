---
// A menu link whose letters roll up, right to left, into their italic "wonky" twins on hover,
// while a crayon underline draws in from the right. Reads as the word being rewritten.
// Screen readers get the plain label; the letter spans are decorative.
interface Props {
  href: string;
  label: string;
  current?: boolean;
  class?: string;
}
const { href, label, current = false, class: className } = Astro.props;
const chars = Array.from(label);
const n = chars.length;
---

<a href={href} class:list={['roll', className, { 'is-current': current }]} aria-current={current ? 'page' : undefined}>
  <span class="sr-only">{label}</span>
  <span class="roll-text" aria-hidden="true" style={`--n:${n}`}>
    {chars.map((c, i) => {
      const ch = c === ' ' ? ' ' : c;
      return (
        <span class="roll-ch" style={`--i:${i}`}>
          <span class="roll-a">{ch}</span>
          <span class="roll-b">{ch}</span>
        </span>
      );
    })}
  </span>
</a>
