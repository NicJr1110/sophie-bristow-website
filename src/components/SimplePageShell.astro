---
interface Props {
  shopHref?: string;
  shopLabel?: string;
  showShopLink?: boolean;
  variant?: 'default' | 'gallery' | 'landing';
}
const {
  shopHref = '/shop-options/',
  shopLabel = 'SHOP',
  showShopLink = true,
  variant = 'default',
} = Astro.props;
---
<div class:list={['simple-site-page', { 'simple-shop-gallery': variant === 'gallery', 'simple-landing': variant === 'landing', 'landing-intro-pending': variant === 'landing' }]}>
  {variant === 'landing' && <div class="simple-grass-intro boil-art" aria-hidden="true">
    {Array.from({ length: 5 }, (_, i) => (
      <img src={`/marks/flowers/grass-${String(i + 1).padStart(2, '0')}.png`} alt="" width="84" height="64" />
    ))}
  </div>}
  <header class="simple-brand">
    <div class="simple-brand-copy">
      <h1>SOPHIE BRISTOW</h1>
      <p>ARTIST BASED IN BRISTOL</p>
    </div>


    <a class="simple-brand-home" href="/" aria-label="Sophie Bristow home">
      <img class="simple-brand-mark" src="/sb-logo.png" alt="" width="326" height="400" />
    </a>
  </header>

  <div class="simple-page-content">
    <slot />
  </div>

  <nav class="simple-bottom-links" aria-label="More">
    {showShopLink && <a class="simple-text-link simple-shop-link" href={shopHref}>
      <svg class="simple-shop-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M2.5 3h2.2l2.1 11.1a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.5L21 7H6" /><circle cx="9.5" cy="19.5" r="1.25" /><circle cx="18" cy="19.5" r="1.25" /></svg>
      <span>{shopLabel}</span>
    </a>}
    <div class="simple-bottom-right">
      <a class="simple-text-link simple-contact-link" href="/contact/">
        <span class="simple-grass boil-art" aria-hidden="true">
          {Array.from({ length: 5 }, (_, i) => (
            <img src={`/marks/flowers/grass-${String(i + 1).padStart(2, '0')}.png`} alt="" width="84" height="64" />
          ))}
        </span>
        <span>CONTACT</span>
      </a>
    </div>
  </nav>
</div>
<script>
  const page = document.querySelector<HTMLElement>('.simple-site-page.simple-landing');
  const intro = page?.querySelector<HTMLElement>('.simple-grass-intro');
  const contactGrass = page?.querySelector<HTMLElement>('.simple-contact-link .simple-grass');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (page && intro && contactGrass && !reduceMotion) {
    const startWidth = Math.min(190, Math.max(150, window.innerWidth * 0.22));
    const startHeight = startWidth * (64 / 84);
    const target = contactGrass.getBoundingClientRect();
    const startLeft = (window.innerWidth - startWidth) / 2;
    const startTop = (window.innerHeight - startHeight) / 2;

    intro.style.left = `${startLeft}px`;
    intro.style.top = `${startTop}px`;
    intro.style.width = `${startWidth}px`;
    intro.style.height = `${startHeight}px`;

    const motion = intro.animate([
      { left: `${startLeft}px`, top: `${startTop}px`, width: `${startWidth}px`, height: `${startHeight}px` },
      { left: `${target.left}px`, top: `${target.top}px`, width: `${target.width}px`, height: `${target.height}px` },
    ], {
      duration: 1050,
      delay: 1350,
      easing: 'cubic-bezier(.22,.72,.18,1)',
      fill: 'forwards',
    });

    motion.onfinish = () => {
      intro.hidden = true;
      page.classList.remove('landing-intro-pending');
      page.classList.add('landing-intro-complete');
    };
  } else if (page) {
    page.classList.remove('landing-intro-pending');
    page.classList.add('landing-intro-complete');
    if (intro) intro.hidden = true;
  }
</script>

