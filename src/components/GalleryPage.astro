---
// Shared template for Flash and Mark Making (spec §6). The page's name comes from Site text.
import Base from '../layouts/Base.astro';
import Gallery from './Gallery.astro';
import { getGallery, getSiteText, pageName } from '../lib/content';

interface Props {
  docId: string;
  href: '/flash/' | '/mark-making/';
}
const { docId, href } = Astro.props;
const gallery = await getGallery(docId, pageName(await getSiteText(), href));
---

<Base title={gallery.title}>
  <h1 class="sr-only">{gallery.title}</h1>
  {gallery.intro && <p class="intro">{gallery.intro}</p>}
  <Gallery items={gallery.items} />
</Base>
