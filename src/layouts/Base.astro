---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { SITE_NAME } from '../lib/config';
import { getSettings } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Landing page hides the header (menu sits in the middle of the page instead). */
  showHeader?: boolean;
  /** Show the flower in the bottom-right corner (off on the landing page). */
  showSplash?: boolean;
  /** Use the full-width editorial page gutters on the shop gallery. */
  widePage?: boolean;
}

const {
  title,
  description = 'Tattoo design, artwork and mark making by Sophie Bristow.',
  showHeader = true,
  showSplash = true,
  widePage = false,
} = Astro.props;
const { backgroundUrl } = await getSettings();
const isDefaultSplash = backgroundUrl === '/splash-flower.png';
const excludedSplashPaths = ['/', '/contact/', '/shop/'];
const shouldShowSplash = showSplash && !excludedSplashPaths.includes(Astro.url.pathname);
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eeede9" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://cdn.sanity.io" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Abel&display=swap"
    />
    {/* <link rel="preload" href="/paper.jpg" as="image" /> */}
  </head>
  <body class:list={{ 'is-landing': !showHeader, 'is-wide': widePage }}>
    {shouldShowSplash && <div class="splash" aria-hidden="true">
      {isDefaultSplash ? (
        <img src="/splash-flower.png" srcset="/splash-flower-sm.png 450w, /splash-flower.png 900w"
          sizes="(min-width: 1024px) 22vh, (min-width: 768px) 22vh, 40vw" alt="" decoding="async" />
      ) : (
        <img src={backgroundUrl} alt="" decoding="async" />
      )}
    </div>}

    <div class="page">
      {showHeader && <Header current={Astro.url.pathname} title={title} />}
      <main class="channel" id="main">
        <slot />
      </main>
      {/* No footer on the landing page: kept as clean as possible */}
      {showHeader && (
        <footer class="site-footer">
          <small>&copy; {year} {SITE_NAME}. All rights reserved.</small>
        </footer>
      )}
    </div>
    <script>
      // Reveal substantial content as it enters the viewport, with a graceful fallback.
      const revealTargets = document.querySelectorAll<HTMLElement>(
        '.simple-choice-card, .grid > li, .bio > *, .enquiry-pick > *, .intro, .shop-tags',
      );

      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const revealObserver = new IntersectionObserver((entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            (entry.target as HTMLElement).classList.add('is-revealed');
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -32px 0px' });

        revealTargets.forEach((element, index) => {
          element.setAttribute('data-reveal', '');
          if (element.matches('.simple-choice-card, .grid > li')) {
            element.style.setProperty('--reveal-delay', `${Math.min(index % 6, 5) * 45}ms`);
          }
          revealObserver.observe(element);
        });
      }
    </script>
  </body>
</html>
