---
 // Shop gallery uses the same page template as Flash and Mark Making, with shop-specific filters and checkout.
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import { getArtworkGallery, getShopTags } from '../lib/content';

const [gallery, tags] = await Promise.all([getArtworkGallery(), getShopTags()]);
const selectedSlug = Astro.url.searchParams.get('tag') ?? '';
const selectedTag = tags.find((tag) => tag.slug === selectedSlug);
const categoryTitle = selectedSlug
  ? (selectedTag?.title ?? selectedSlug.replace(/[-_]+/g, ' '))
  : 'all';
---

<Base title="Shop" subtitle={categoryTitle}>
  <h1 class="page-title page-title--nav">Shop</h1>
  <p class="shop-category-subtitle" data-shop-subtitle>{categoryTitle}</p>
  {gallery.intro && <p class="intro">{gallery.intro}</p>}
  {tags.length > 0 && (
    <nav class="shop-tags" aria-label="Filter the shop">
      {tags.map((t) => (
        <a class="scratch" href={`/shop/?tag=${t.slug}`} data-tag={t.slug}>{t.title}</a>
      ))}
      <a class="scratch" href="/shop/" data-tag="">all</a>
    </nav>
  )}
  <p class="shop-message" role="status" aria-live="polite" hidden></p>
  <Gallery items={gallery.items} shop />
</Base>

<script>
  // Filter by ?tag= (from the landing page's shop links, or the tag links above the grid).
  const categoryNames = new Map<string, string>([
    ...Array.from(document.querySelectorAll<HTMLAnchorElement>('.shop-tags a[data-tag]'))
      .filter((a) => a.dataset.tag)
      .map((a) => [a.dataset.tag!, a.textContent?.trim() ?? a.dataset.tag!] as [string, string]),
    ['', 'all'],
  ]);
  const updateCategoryTitle = (tag: string) => {
    const label = tag ? (categoryNames.get(tag) ?? tag.replace(/[-_]+/g, ' ')) : 'all';
    document.querySelectorAll<HTMLElement>('[data-shop-subtitle]').forEach((el) => {
      el.textContent = label;
    });
  };
  const filterByTag = () => {
    const tag = new URLSearchParams(location.search).get('tag') ?? '';
    updateCategoryTitle(tag);
    document.querySelectorAll<HTMLLIElement>('[data-gallery] > li').forEach((li) => {
      li.hidden = Boolean(tag) && !(li.dataset.tags ?? '').split(' ').includes(tag);
    });
    document.querySelectorAll<HTMLAnchorElement>('.shop-tags a').forEach((a) => {
      const on = a.dataset.tag === tag;
      a.classList.toggle('is-current', on);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  };
  filterByTag();
  window.addEventListener('popstate', filterByTag);
  document.querySelectorAll<HTMLAnchorElement>('.shop-tags a').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      history.replaceState(null, '', a.href);
      filterByTag();
    }),
  );

  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('button.buy'));
  const message = document.querySelector<HTMLParagraphElement>('.shop-message')!;

  const setButton = (btn: HTMLButtonElement, status: 'available' | 'sold') => {
    btn.disabled = status !== 'available';
    btn.textContent = status === 'available' ? 'Buy' : 'Sold';
  };

  const say = (text: string) => {
    message.textContent = text;
    message.hidden = !text;
  };

  // Live sold status, so a purchase shows up without a redeploy.
  async function refreshStatus() {
    try {
      const res = await fetch('/api/status', { cache: 'no-store' });
      if (!res.ok) return;
      const statuses: Record<string, 'available' | 'sold'> = await res.json();
      for (const btn of buttons) {
        const s = statuses[btn.dataset.artworkId ?? ''];
        if (s) setButton(btn, s);
      }
    } catch {
      /* Keep the build-time status if the API isn't reachable (e.g. `astro dev`). */
    }
  }

  for (const btn of buttons) {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.artworkId;
      if (!id) return;
      say('');
      btn.disabled = true;
      btn.textContent = 'One moment…';
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ artworkId: id }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.url) {
          window.location.href = data.url; // Stripe-hosted checkout
          return;
        }
        if (res.status === 409) {
          setButton(btn, 'sold');
          say('Sorry, that piece has just sold.');
          return;
        }
        throw new Error(data.error ?? 'checkout_failed');
      } catch {
        setButton(btn, 'available');
        say('Oops, something appears to have gone wrong. Please try again later.');
      }
    });
  }

  refreshStatus();
  // Coming back from Stripe with the browser back button restores a cached page: refresh it.
  window.addEventListener('pageshow', (e) => e.persisted && refreshStatus());
</script>
