---
import Base from '../layouts/Base.astro';
---
<Base title="Shop" showHeader={false} showSplash={false}>
  <section class="simple-home simple-shop" aria-labelledby="site-name">
    <header class="simple-brand"><h1 id="site-name">SOPHIE BRISTOW</h1><p>ARTIST BASED IN BRISTOL</p></header>
    <nav class="simple-cards" aria-label="Shop categories">
      <a class="simple-card" href="/shop/all/?tag=artwork"><span class="simple-card-title">ARTWORKS</span><span class="simple-card-subtitle">Browse our collection of original artworks.</span><span class="simple-card-link">BROWSE</span></a>
      <a class="simple-card" href="/shop/all/?tag=gift-cards"><span class="simple-card-title">GIFT CARDS</span><span class="simple-card-subtitle">Give the gift of art.</span><span class="simple-card-link">BROWSE</span></a>
    </nav>
    <footer class="simple-shop-footer"><a class="simple-text-link" href="/shop/all/">SHOP ALL</a></footer>
  </section>
</Base>