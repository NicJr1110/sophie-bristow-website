---
import Base from '../layouts/Base.astro';
import { getBio, getSiteText, pageName } from '../lib/content';

const [bio, text] = await Promise.all([getBio(), getSiteText()]);
---

<Base title={pageName(text, '/bio/')}>
  <h1 class="sr-only">{pageName(text, '/bio/')}</h1>
  <article class="bio">
    {bio.photo && (
      <img
        class="bio-photo"
        src={bio.photo.full(1200)}
        srcset={`${bio.photo.full(600)} 600w, ${bio.photo.full(1200)} 1200w, ${bio.photo.full(1800)} 1800w`}
        sizes="(min-width: 1024px) 600px, 90vw"
        alt={bio.photo.alt}
        decoding="async"
      />
    )}
    <div class="prose" set:html={bio.html} />
  </article>
</Base>
