---
import Base from '../layouts/Base.astro';
import { getMenuSubtitles, getSettings } from '../lib/content';
const [subtitles, settings] = await Promise.all([getMenuSubtitles(), getSettings()]);
---
<Base showHeader={false} showSplash={false}>
  <section class="simple-home" aria-labelledby="site-name">
    <header class="simple-brand"><h1 id="site-name">SOPHIE BRISTOW</h1><p>ARTIST BASED IN BRISTOL</p></header>
    <nav class="simple-cards" aria-label="Explore">
      <a class="simple-card" href="/flash/"><span class="simple-card-title">FLASH</span><span class="simple-card-subtitle">{subtitles.flash}</span><span class="simple-card-link">BROWSE</span></a>
      <a class="simple-card" href="/mark-making/"><span class="simple-card-title">MARK MAKING</span><span class="simple-card-subtitle">{subtitles.markMaking}</span><span class="simple-card-link">BROWSE</span></a>
    </nav>
    <footer class="simple-home-footer">
      {settings.showShop && <a class="simple-text-link" href="/shop/">SHOP</a>}
      <img class="simple-grass" src="/marks/flowers/grass-01.png" alt="" width="80" height="72" />
      <a class="simple-text-link simple-contact" href="/contact/">CONTACT</a>
    </footer>
  </section>
</Base>