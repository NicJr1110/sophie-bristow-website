---
import Base from '../layouts/Base.astro';
import ScratchLink from '../components/ScratchLink.astro';
import { SITE_NAME, USE_MONOGRAM } from '../lib/config';
import { getNav } from '../lib/content';

// The work on the left, about/contact on the right, meeting at the centre line of the page:
// 3 + 2 with the shop on, 2 + 2 while it's off.
const nav = await getNav();
const WORK = ['/flash/', '/mark-making/', '/shop/'];
const left = nav.filter((item) => WORK.includes(item.href));
const right = nav.filter((item) => !WORK.includes(item.href));
---

<Base showHeader={false}>
  <div class="landing">
    <h1 class="landing-name">
      {USE_MONOGRAM ? (
        <img class="monogram monogram--large" src="/sb-monogram.svg" alt={SITE_NAME} width="80" height="144" />
      ) : (
        SITE_NAME
      )}
    </h1>
    <nav class="landing-menu" aria-label="Main">
      <ul class="landing-col landing-col--left">
        {left.map((item) => <li><ScratchLink href={item.href} label={item.label} /></li>)}
      </ul>
      <ul class="landing-col landing-col--right">
        {right.map((item) => <li><ScratchLink href={item.href} label={item.label} /></li>)}
      </ul>
    </nav>
  </div>
</Base>
