---
// Landing: Sophie's name and mark, then two cards (Flash and Mark Making). Shop and Contact
// sit at the bottom; the grass intro plays once per browser session (SimplePageShell).
import Base from '../layouts/Base.astro';
import SimplePageShell from '../components/SimplePageShell.astro';
import { getLandingChoices, getSettings, getSiteText } from '../lib/content';

const [{ showShop }, choices, text] = await Promise.all([getSettings(), getLandingChoices(), getSiteText()]);
---

<Base showHeader={false} showSplash={false}>
  <SimplePageShell showShopLink={showShop} landing>
    <section class="simple-choice-grid" aria-label="Explore Sophie’s work">
      {choices.map((c) => (
        <a class="simple-choice-card" href={c.href}>
          <h2>{c.label}</h2>
          {c.subtitle && <p>{c.subtitle}</p>}
          <span class="simple-choice-browse">{text.browseLabel}</span>
        </a>
      ))}
    </section>
  </SimplePageShell>
</Base>
