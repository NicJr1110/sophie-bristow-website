---
// Hidden page for choosing the heading font. Not linked anywhere; delete once a font is chosen.
// To switch fonts: change --font-heading (and --heading-weight) in global.css and the Google Fonts link in Base.astro.
import Base from '../layouts/Base.astro';

const FONTS: { name: string; family: string; weight: number; scale: number; note: string }[] = [
  { name: 'Instrument Sans', family: 'Instrument Sans', weight: 500, scale: 1, note: 'Made by a design studio; crisp and quietly characterful. (Current.)' },
  { name: 'Hanken Grotesk', family: 'Hanken Grotesk', weight: 500, scale: 1, note: 'Open, Swiss-style grotesk. Calm and gallery-like.' },
  { name: 'Inter Tight', family: 'Inter Tight', weight: 500, scale: 0.98, note: 'Tighter Inter. Very clean, Helvetica-adjacent.' },
  { name: 'Schibsted Grotesk', family: 'Schibsted Grotesk', weight: 500, scale: 1, note: 'Editorial grotesk with a little warmth.' },
  { name: 'Albert Sans', family: 'Albert Sans', weight: 500, scale: 1, note: 'Scandinavian geometric. Airy, modern brochure.' },
  { name: 'Manrope', family: 'Manrope', weight: 500, scale: 0.96, note: 'Rounded-modern. Friendly, very open.' },
  { name: 'Figtree', family: 'Figtree', weight: 500, scale: 1, note: 'Clean geometric, slightly softer.' },
];

const href =
  'https://fonts.googleapis.com/css2?' +
  FONTS.map((f) => `family=${f.family.replace(/ /g, '+')}:wght@400;500;600`).join('&') +
  '&display=swap';
---

<Base title="Font test">
  <!-- Candidate fonts (a stylesheet link in the body works fine for a test page) -->
  <link rel="stylesheet" href={href} />

  <h1 class="page-title">Font test</h1>
  <p class="intro">Each block shows a candidate font for the whole site: name, menu and body text. Hover the menu words to see the scratch line.</p>

  <div class="type-tests">
    {FONTS.map((f, i) => (
      <section class="type-test" style={`--f:'${f.family}';--w:${f.weight};--s:${f.scale}`}>
        <p class="type-label">{i + 1}. {f.name}</p>
        <p class="type-note">{f.note}</p>
        <p class="type-name">Sophie Bristow</p>
        <p class="type-menu">
          <a class="scratch is-current" href="#">Flash</a>
          <a class="scratch" href="#">Mark Making</a>
          <a class="scratch" href="#">Artwork</a>
          <a class="scratch" href="#">Bio</a>
          <a class="scratch" href="#">Contact</a>
        </p>
        <p class="type-body">
          Hand-poked tattoos and original drawings from my little blue flashbook. Taking bookings for November and
          December, with a London waiting list.
        </p>
      </section>
    ))}
  </div>
</Base>

<style>
  .type-tests {
    display: grid;
    gap: 28px;
  }
  .type-test {
    padding: 22px 24px 18px;
    background: rgb(255 255 255 / 0.35);
    box-shadow:
      0 1px 1.5px rgb(60 45 30 / 0.1),
      0 3px 8px -2px rgb(60 45 30 / 0.1);
  }
  .type-label {
    margin: 0;
    font-weight: 600;
  }
  .type-note {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .type-name,
  .type-menu .scratch,
  .type-body {
    font-family: var(--f), sans-serif;
    font-weight: var(--w);
  }
  .type-name {
    margin: 0 0 6px;
    font-size: calc(2.4rem * var(--s));
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .type-menu {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0 0 14px;
  }
  .type-menu .scratch {
    font-size: calc(1.15rem * var(--s));
  }
  .type-body {
    font-weight: 400;
    margin: 0;
    max-width: 60ch;
  }
</style>
