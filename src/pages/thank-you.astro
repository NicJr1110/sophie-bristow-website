---
import Base from '../layouts/Base.astro';
import { getSiteText } from '../lib/content';

const text = await getSiteText();
---

<Base title={text.thankYouTitle}>
  <div class="notice">
    <h1 class="page-title">{text.thankYouTitle}</h1>
    <p>{text.thankYouMessage}</p>
    <p><a href="/shop/">{text.shopLink}</a></p>
  </div>
</Base>
