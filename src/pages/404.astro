---
import Base from '../layouts/Base.astro';
import { getSiteText } from '../lib/content';

const text = await getSiteText();
---

<Base title={text.notFoundTitle}>
  <div class="notice">
    <h1 class="page-title">{text.notFoundTitle}</h1>
    <p><a href="/">{text.homeLink}</a></p>
  </div>
</Base>
