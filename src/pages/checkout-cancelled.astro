---
import Base from '../layouts/Base.astro';
import { getSiteText } from '../lib/content';

const text = await getSiteText();
---

<Base title={text.cancelledTitle}>
  <div class="notice">
    <h1 class="page-title">{text.cancelledTitle}</h1>
    <p>{text.cancelledMessage}</p>
    <p><a href="/shop/">{text.shopLink}</a></p>
  </div>
</Base>

<script>
  // Release the 30-minute reservation straight away instead of waiting for it to lapse.
  const params = new URLSearchParams(location.search);
  const artworkId = params.get('a');
  const token = params.get('t');
  if (artworkId && token) {
    fetch('/api/release', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ artworkId, token }),
      keepalive: true,
    }).catch(() => {});
    history.replaceState(null, '', location.pathname);
  }
</script>
