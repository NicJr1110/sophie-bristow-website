---
import Base from '../layouts/Base.astro';
import { getEnquiryTypes } from '../lib/content';

// Enquiry types come from Sanity; each maps to its own auto-reply template.
const enquiryTypes = await getEnquiryTypes();
---

<Base title="Contact">
  <h1 class="page-title">Contact</h1>

  <form id="contact-form" class="contact-form" method="post" action="/api/contact">
    {enquiryTypes.length > 0 && (
      <fieldset class="enquiry-types">
        <legend>What's it about?</legend>
        <div class:list={['enquiry-grid', { 'is-single': enquiryTypes.length === 1 }]}>
          {enquiryTypes.map((t, i) => (
            <label class="enquiry-option">
              <input
                type="radio"
                name="enquiryType"
                value={t.id}
                required
                checked={enquiryTypes.length === 1 && i === 0}
              />
              <span>{t.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    )}

    <label>
      Name
      <input name="name" type="text" required maxlength="200" autocomplete="name" />
    </label>
    <label>
      Email
      <input name="email" type="email" required maxlength="254" autocomplete="email" />
    </label>
    <label>
      Message
      <textarea name="message" rows="7" required maxlength="2000"></textarea>
      <span class="char-count" aria-live="polite">0 / 2000</span>
    </label>

    <!-- Honeypot: hidden from people, bots fill it in -->
    <div class="hp" aria-hidden="true">
      <label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button class="button" type="submit">Send</button>
    <p class="form-error" role="alert" hidden>Oops, something appears to have gone wrong. Please try again later.</p>
  </form>

  <div class="form-success" role="status" tabindex="-1" hidden>
    <p>Thank you very much, Sophie will be in touch with you shortly.</p>
  </div>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const success = document.querySelector<HTMLElement>('.form-success')!;
  const error = form.querySelector<HTMLElement>('.form-error')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const message = form.querySelector<HTMLTextAreaElement>('textarea[name=message]')!;
  const count = form.querySelector<HTMLElement>('.char-count')!;

  message.addEventListener('input', () => (count.textContent = `${message.value.length} / 2000`));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    // All fields, including the enquiry type, are required.
    if (!form.reportValidity()) return;
    error.hidden = true;
    submit.disabled = true;
    submit.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      // Happy path: the whole form (and its heading) goes, leaving just the message, centred.
      form.hidden = true;
      document.querySelector<HTMLElement>('.page-title')?.setAttribute('hidden', '');
      success.hidden = false;
      window.scrollTo({ top: 0 });
      success.focus({ preventScroll: true });
    } catch {
      error.hidden = false; // Failure: keep what they typed
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send';
    }
  });
</script>
