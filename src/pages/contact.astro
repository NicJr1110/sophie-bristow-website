---
// Contact, in two steps:
//   1. What's it about? The enquiry types as a big lowercase list, like the landing menu.
//   2. The form: "name" and "email" on underlined lines, then a message area. Each enquiry
//      type has its own auto-reply template and inbox in Sanity.
// Arriving from "Enquire" on a Flash or Mark Making image (?piece=…&about=…), the type is
// already chosen and a thumbnail shows which piece will be sent to Sophie with the message.
import Base from '../layouts/Base.astro';
import Boil from '../components/Boil.astro';
import { getEnquirePieces, getEnquiryTypes, getSiteText, pageName } from '../lib/content';

const [enquiryTypes, pieces, text] = await Promise.all([getEnquiryTypes(), getEnquirePieces(), getSiteText()]);
const name = pageName(text, '/contact/');
// Thumbnails and names for the "about this piece" reference, keyed by piece. "<" is escaped
// so nothing in a title can close the script tag.
const piecesJson = JSON.stringify(Object.fromEntries(pieces.map((p) => [p.ref, p]))).replace(/</g, '\\u003c');
// With one type (or none) there's nothing to choose, so go straight to the form.
const choose = enquiryTypes.length > 1;
const only = enquiryTypes.length === 1 ? enquiryTypes[0] : null;
const LINE_COUNT = 17;
---

<Base title={name} showSplash={false}>
  <h1 class="sr-only">{name}</h1>
  <script type="application/json" id="enquire-pieces" set:html={piecesJson}></script>

  <!-- The piece they pressed Enquire on (filled in by the script below) -->
  <div class="lined-ref" hidden>
    <img alt="" width="64" height="64" />
    <p>
      <small class="lined-ref-page"></small>
      <span class="lined-ref-title"></span>
    </p>
    <button class="lined-ref-remove" type="button">{text.removeLabel}</button>
  </div>

  {choose && (
    <div class="enquiry-pick">
      <nav class="drawn-menu" aria-label="What's it about?">
        <ul class="drawn-list">
          {enquiryTypes.map((t) => (
            <li class="drawn-item">
              <button class="drawn-link" type="button" data-type={t.id} data-label={t.label}>
                {t.label.toLowerCase()}
              </button>
            </li>
          ))}
        </ul>
      </nav>
      <!-- One of Sophie's grass drawings, large, at the foot of the page; it boils on hover -->
      <Boil set="grass" play="hover" class="enquiry-grass" />
    </div>
  )}

  <form id="contact-form" class="lined-form" method="post" action="/api/contact" hidden={choose}>
    <input type="hidden" name="enquiryType" value={only?.id ?? ''} />
    <input type="hidden" name="piece" value="" />

    {choose && (
      <p class="lined-about">
        <span>{text.aboutLabel} <b class="lined-about-label"></b></span>
        <button class="lined-change" type="button">{text.changeLabel}</button>
      </p>
    )}

    <label class="lined-row">
      <span>{text.nameLabel}</span>
      <input name="name" type="text" required maxlength="200" autocomplete="name" />
    </label>
    <label class="lined-row">
      <span>{text.emailLabel}</span>
      <input name="email" type="email" required maxlength="254" autocomplete="email" />
    </label>

    <div class="lined-message">
      <label class="sr-only" for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="9" required maxlength="2000" placeholder={text.messagePlaceholder}
      ></textarea>
      <span class="char-count" aria-live="polite">0 / 2000</span>
      <!-- Wide screens only: Sophie's flower boils beside the message area, outside the content column -->
      <Boil set="flower" class="lined-flower" />
    </div>

    <!-- Honeypot: hidden from people, bots fill it in -->
    <div class="hp" aria-hidden="true">
      <label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button class="button" type="submit" data-sending={text.sendingLabel}>{text.sendLabel}</button>
    <p class="form-error" role="alert" hidden>{text.contactErrorMessage}</p>
  </form>

  <div class="form-success" role="status" tabindex="-1" hidden>
    <p class="form-success-title">{text.sentTitle}</p>
    <p class="form-success-note">{text.sentMessage}</p>
    <img class="form-success-flowers" src="/splash-flower-sm.png" alt="" width="450" height="532" />
  </div>
</Base>

<script define:vars={{ LINE_COUNT }}>
  // Hovering an enquiry type draws one of Sophie's lines under it, picked at random.
  const pad = (n) => String(n).padStart(2, '0');
  let last = 0;
  const nextLine = () => {
    let n;
    do n = 1 + Math.floor(Math.random() * LINE_COUNT);
    while (n === last);
    last = n;
    return `url('/marks/lines/line-${pad(n)}.png')`;
  };
  document.querySelectorAll('.enquiry-pick .drawn-item').forEach((li) => {
    const draw = () => {
      if (li.classList.contains('is-drawn')) return;
      li.style.setProperty('--line', nextLine());
      li.classList.add('is-drawn');
    };
    const undraw = () => {
      if (li.matches(':hover') || li.contains(document.activeElement)) return;
      li.classList.remove('is-drawn');
    };
    li.addEventListener('mouseenter', draw);
    li.addEventListener('focusin', draw);
    li.addEventListener('mouseleave', undraw);
    li.addEventListener('focusout', () => setTimeout(undraw));
  });
</script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const pick = document.querySelector<HTMLElement>('.enquiry-pick');
  const typeInput = form.querySelector<HTMLInputElement>('input[name=enquiryType]')!;
  const aboutLabel = form.querySelector<HTMLElement>('.lined-about-label');
  const success = document.querySelector<HTMLElement>('.form-success')!;
  const error = form.querySelector<HTMLElement>('.form-error')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const message = form.querySelector<HTMLTextAreaElement>('textarea[name=message]')!;
  const count = form.querySelector<HTMLElement>('.char-count')!;
  const pieceInput = form.querySelector<HTMLInputElement>('input[name=piece]')!;
  const ref = document.querySelector<HTMLElement>('.lined-ref')!;

  type Piece = { ref: string; page: string; title: string; thumb: string };
  const pieces: Record<string, Piece> = JSON.parse(document.getElementById('enquire-pieces')?.textContent || '{}');

  /** Change one value in the address, keeping the others (so the piece survives step changes). */
  const withParam = (name: string, value: string | null) => {
    const p = new URLSearchParams(location.search);
    if (value === null) p.delete(name);
    else p.set(name, value);
    const q = p.toString();
    return q ? `?${q}` : location.pathname;
  };

  // "About this piece": shown when they came from Enquire on an image Sophie still has.
  const showPiece = () => {
    const piece = pieces[new URLSearchParams(location.search).get('piece') ?? ''];
    ref.hidden = !piece;
    pieceInput.value = piece?.ref ?? '';
    if (!piece) return;
    ref.querySelector('img')!.src = piece.thumb;
    ref.querySelector('.lined-ref-page')!.textContent = piece.page;
    ref.querySelector('.lined-ref-title')!.textContent = piece.title;
  };
  ref.querySelector('.lined-ref-remove')!.addEventListener('click', () => {
    history.replaceState(null, '', withParam('piece', null));
    showPiece();
    form.querySelector<HTMLTextAreaElement>('textarea')?.focus();
  });

  // Step 1 → step 2. The choice goes in the URL (?about=…) so Back returns to the list.
  const showStep = () => {
    showPiece();
    if (!pick) return;
    const id = new URLSearchParams(location.search).get('about');
    const btn = id ? pick.querySelector<HTMLButtonElement>(`[data-type="${CSS.escape(id)}"]`) : null;
    pick.hidden = Boolean(btn);
    form.hidden = !btn;
    typeInput.value = btn?.dataset.type ?? '';
    if (aboutLabel) aboutLabel.textContent = (btn?.dataset.label ?? '').toLowerCase();
    return btn;
  };
  pick?.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((btn) =>
    btn.addEventListener('click', () => {
      history.pushState(null, '', withParam('about', btn.dataset.type!));
      showStep();
      form.querySelector<HTMLInputElement>('input[name=name]')?.focus();
    }),
  );
  form.querySelector('.lined-change')?.addEventListener('click', () => {
    history.pushState(null, '', withParam('about', null));
    showStep();
    pick?.querySelector<HTMLButtonElement>(`[data-type="${CSS.escape(typeInput.value || '')}"]`)?.focus();
  });
  addEventListener('popstate', showStep);
  showStep();

  message.addEventListener('input', () => (count.textContent = `${message.value.length} / 2000`));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    error.hidden = true;
    const sendLabel = submit.textContent;
    submit.disabled = true;
    submit.textContent = submit.dataset.sending ?? '';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      // Happy path: the form goes, leaving "Sent", the thank-you and the flowers.
      form.hidden = true;
      ref.hidden = true;
      success.hidden = false;
      window.scrollTo({ top: 0 });
      success.focus({ preventScroll: true });
    } catch {
      error.hidden = false; // Failure: keep what they typed
    } finally {
      submit.disabled = false;
      submit.textContent = sendLabel;
    }
  });
</script>
