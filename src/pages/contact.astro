---
// Contact, in two steps:
//   1. What's it about? The enquiry types as a big lowercase list, like the landing menu.
//   2. The form: "name" and "email" on underlined lines, then a message area. Each enquiry
//      type has its own auto-reply template and inbox in Sanity.
import Base from '../layouts/Base.astro';
import Boil from '../components/Boil.astro';
import { getEnquiryTypes } from '../lib/content';

const enquiryTypes = await getEnquiryTypes();
// With one type (or none) there's nothing to choose, so go straight to the form.
const choose = enquiryTypes.length > 1;
const only = enquiryTypes.length === 1 ? enquiryTypes[0] : null;
const LINE_COUNT = 17;
---

<Base title="Contact" showSplash={false}>
  <h1 class="sr-only">Contact</h1>

  {choose && (
    <div class="enquiry-pick">
      <nav class="drawn-menu" aria-label="What's it about?">
        <ul class="drawn-list">
          {enquiryTypes.map((t) => (
            <li class="drawn-item">
              <button class="drawn-link" type="button" data-type={t.id} data-label={t.label}>
                {t.label.toLowerCase()}
              </button>
            </li>
          ))}
        </ul>
      </nav>
      <!-- One of Sophie's grass drawings, large, at the foot of the page; it boils on hover -->
      <Boil set="grass" play="hover" class="enquiry-grass" />
    </div>
  )}

  <form id="contact-form" class="lined-form" method="post" action="/api/contact" hidden={choose}>
    <input type="hidden" name="enquiryType" value={only?.id ?? ''} />

    {choose && (
      <p class="lined-about">
        <span>About: <b class="lined-about-label"></b></span>
        <button class="lined-change" type="button">change</button>
      </p>
    )}

    <label class="lined-row">
      <span>name</span>
      <input name="name" type="text" required maxlength="200" autocomplete="name" />
    </label>
    <label class="lined-row">
      <span>email</span>
      <input name="email" type="email" required maxlength="254" autocomplete="email" />
    </label>

    <div class="lined-message">
      <label class="sr-only" for="contact-message">Message</label>
      <textarea id="contact-message" name="message" rows="9" required maxlength="2000" placeholder="start typing here…"
      ></textarea>
      <span class="char-count" aria-live="polite">0 / 2000</span>
      <!-- Wide screens only: Sophie's flower boils beside the message area, outside the content column -->
      <Boil set="flower" class="lined-flower" />
    </div>

    <!-- Honeypot: hidden from people, bots fill it in -->
    <div class="hp" aria-hidden="true">
      <label>Leave this empty <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button class="button" type="submit">Send</button>
    <p class="form-error" role="alert" hidden>Oops, something appears to have gone wrong. Please try again later.</p>
  </form>

  <div class="form-success" role="status" tabindex="-1" hidden>
    <p class="form-success-title">Sent</p>
    <p class="form-success-note">Thank you very much, Sophie will be in touch with you shortly.</p>
    <img class="form-success-flowers" src="/splash-flower-sm.png" alt="" width="450" height="532" />
  </div>
</Base>

<script define:vars={{ LINE_COUNT }}>
  // Hovering an enquiry type draws one of Sophie's lines under it, picked at random.
  const pad = (n) => String(n).padStart(2, '0');
  let last = 0;
  const nextLine = () => {
    let n;
    do n = 1 + Math.floor(Math.random() * LINE_COUNT);
    while (n === last);
    last = n;
    return `url('/marks/lines/line-${pad(n)}.png')`;
  };
  document.querySelectorAll('.enquiry-pick .drawn-item').forEach((li) => {
    const draw = () => {
      if (li.classList.contains('is-drawn')) return;
      li.style.setProperty('--line', nextLine());
      li.classList.add('is-drawn');
    };
    const undraw = () => {
      if (li.matches(':hover') || li.contains(document.activeElement)) return;
      li.classList.remove('is-drawn');
    };
    li.addEventListener('mouseenter', draw);
    li.addEventListener('focusin', draw);
    li.addEventListener('mouseleave', undraw);
    li.addEventListener('focusout', () => setTimeout(undraw));
  });
</script>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const pick = document.querySelector<HTMLElement>('.enquiry-pick');
  const typeInput = form.querySelector<HTMLInputElement>('input[name=enquiryType]')!;
  const aboutLabel = form.querySelector<HTMLElement>('.lined-about-label');
  const success = document.querySelector<HTMLElement>('.form-success')!;
  const error = form.querySelector<HTMLElement>('.form-error')!;
  const submit = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
  const message = form.querySelector<HTMLTextAreaElement>('textarea[name=message]')!;
  const count = form.querySelector<HTMLElement>('.char-count')!;

  // Step 1 → step 2. The choice goes in the URL (?about=…) so Back returns to the list.
  const showStep = () => {
    if (!pick) return;
    const id = new URLSearchParams(location.search).get('about');
    const btn = id ? pick.querySelector<HTMLButtonElement>(`[data-type="${CSS.escape(id)}"]`) : null;
    pick.hidden = Boolean(btn);
    form.hidden = !btn;
    typeInput.value = btn?.dataset.type ?? '';
    if (aboutLabel) aboutLabel.textContent = (btn?.dataset.label ?? '').toLowerCase();
    return btn;
  };
  pick?.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((btn) =>
    btn.addEventListener('click', () => {
      history.pushState(null, '', `?about=${encodeURIComponent(btn.dataset.type!)}`);
      showStep();
      form.querySelector<HTMLInputElement>('input[name=name]')?.focus();
    }),
  );
  form.querySelector('.lined-change')?.addEventListener('click', () => {
    history.pushState(null, '', location.pathname);
    showStep();
    pick?.querySelector<HTMLButtonElement>(`[data-type="${CSS.escape(typeInput.value || '')}"]`)?.focus();
  });
  addEventListener('popstate', showStep);
  showStep();

  message.addEventListener('input', () => (count.textContent = `${message.value.length} / 2000`));

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    error.hidden = true;
    submit.disabled = true;
    submit.textContent = 'Sending…';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      if (!res.ok) throw new Error(String(res.status));
      // Happy path: the form goes, leaving "Sent", the thank-you and the flowers.
      form.hidden = true;
      success.hidden = false;
      window.scrollTo({ top: 0 });
      success.focus({ preventScroll: true });
    } catch {
      error.hidden = false; // Failure: keep what they typed
    } finally {
      submit.disabled = false;
      submit.textContent = 'Send';
    }
  });
</script>
